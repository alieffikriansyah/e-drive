APP_NAME=E-Drive
APP_ENV=development
APP_DEBUG=true

# Database Configuration
# Gunakan DB_HOST=localhost (untuk local/XAMPP) atau DB_HOST=db (untuk Docker)
DB_HOST=localhost
DB_NAME=e_drive
DB_USER=root
DB_PASS=

# Base URL (akhiri dengan slash /)
# Local: http://localhost/e-drive/ | Docker: http://localhost:8080/
BASE_URL=http://localhost:8080/

# ONLYOFFICE Document Server
# Local: http://localhost:8080/ | Docker: http://localhost:8082/
ONLYOFFICE_URL=http://localhost:8082/
ONLYOFFICE_SECRET=your_secret_jwt_key
ONLYOFFICE_JWT_SECRET=your_secret_jwt_key

# AI Configuration
FLOWISE_URL=http://localhost:3000
FLOWISE_API_KEY=
OLLAMA_URL=http://localhost:11434
AI_DEFAULT_MODEL=qwen3
