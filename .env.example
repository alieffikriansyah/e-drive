# ==============================================================================
# 1. KONFIGURASI LINUX (Docker E-Drive + Docker OnlyOffice di Port 8082)
#    -> Gunakan opsi ini saat menjalankan di Docker Linux lokal Anda
# ==============================================================================
APP_NAME=E-Drive
APP_ENV=development
APP_DEBUG=true

# Database Docker
DB_HOST=db
DB_NAME=e_drive
DB_USER=root
DB_PASS=

# Base URL Web Docker
BASE_URL=http://localhost:8080/

# OnlyOffice (Docker container e_drive_onlyoffice di port 8082)
ONLYOFFICE_URL=http://localhost:8082/
ONLYOFFICE_SECRET=super_secret_jwt_key_123
ONLYOFFICE_JWT_SECRET=super_secret_jwt_key_123
ONLYOFFICE_USE_DOCKER_HOST=true

# AI Configuration
FLOWISE_URL=http://localhost:3000
FLOWISE_API_KEY=
OLLAMA_URL=http://localhost:11434
AI_DEFAULT_MODEL=qwen3


# ==============================================================================
# 2. KONFIGURASI WINDOWS (XAMPP + Docker Engine OnlyOffice di Port 8082)
#    -> Copy & aktifkan bagian ini ke .env jika sedang bekerja di Windows
# ==============================================================================
# APP_NAME=E-Drive
# APP_ENV=development
# APP_DEBUG=true
# 
# # Database XAMPP Lokal
# DB_HOST=localhost
# DB_NAME=e_drive
# DB_USER=root
# DB_PASS=
# 
# # Base URL XAMPP
# BASE_URL=http://localhost/e-drive/
# 
# # OnlyOffice (Docker Engine Windows di port 8082 - SAMA PERSIS dengan Linux)
# ONLYOFFICE_URL=http://localhost:8082/
# ONLYOFFICE_SECRET=super_secret_jwt_key_123
# ONLYOFFICE_JWT_SECRET=super_secret_jwt_key_123
# ONLYOFFICE_USE_DOCKER_HOST=true
# 
# # AI Configuration
# FLOWISE_URL=http://localhost:3000
# FLOWISE_API_KEY=
# OLLAMA_URL=http://localhost:11434
# AI_DEFAULT_MODEL=qwen3


# ==============================================================================
# 3. KONFIGURASI PRODUCTION (Server Hosting / cPanel Tanpa Docker)
#    -> Copy & sesuaikan bagian ini ke .env saat aplikasi di-upload ke cPanel
# ==============================================================================
# APP_NAME=E-Drive
# APP_ENV=production
# APP_DEBUG=false
# 
# # Database Hosting cPanel
# DB_HOST=localhost
# DB_NAME=usercpanel_edrive
# DB_USER=usercpanel_edriveuser
# DB_PASS=PasswordDatabaseHosting123#
# 
# # Base URL Domain Asli
# BASE_URL=https://nama-domain-anda.com/
# 
# # OnlyOffice dinonaktifkan (fitur edit disembunyikan otomatis)
# ONLYOFFICE_URL=
# ONLYOFFICE_SECRET=
# ONLYOFFICE_JWT_SECRET=
# ONLYOFFICE_USE_DOCKER_HOST=false
# 
# # AI Configuration (Opsional)
# FLOWISE_URL=
# FLOWISE_API_KEY=
# OLLAMA_URL=
# AI_DEFAULT_MODEL=
